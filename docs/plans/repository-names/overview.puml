@startuml
title Repository names in a shared store - slices
package "repository-registration" as Registration {
  interface "name check" as Check
  interface "repositories/<name>.json" as RegistrationFile
}
package "registration-sync" as Sync
package "machine-checkouts" as Checkouts {
  interface "checkouts.json in Prism's application folder" as List
}
Sync ..> Registration : confirms new registrations
Sync ..> RegistrationFile : merges as a store record
Checkouts ..> Check : records a checkout once accepted
@enduml
