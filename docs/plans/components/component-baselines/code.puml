@startuml
title component-baselines - units
package "conservation" {
  component "conservation-store.mts" as Store
  component "conservation-analysis.mts" as Analysis
  component "derived-change-map.mjs" as Derived
}
package "repository-intelligence" {
  component "component-indexes.mts" as Indexes
  component "semantic-native-provider.mts" as Provider
}
Derived --> Analysis : prepareAnalysis
Analysis --> Indexes : prepare every baseline component
Provider --> Indexes : snapshotId calls
Indexes --> Store : retained source split per component
Analysis --> Store : retain union analysis
@enduml
