@startuml
title component-index-preparation - units
package "repository-intelligence" {
  component "component-indexes.mts" as Indexes
  component "native-semantic-runtime.mts" as Runtime
  component "native-repository-intelligence.mjs" as Scan
  component "index-progress.mts" as Progress
  component "semantic-native-provider.mts" as Provider
}
package "workflow" {
  component "components.mjs" as Model
}
component "mcp.mjs" as Mcp
Mcp --> Provider : search_repository_concepts
Mcp --> Runtime : status tools
Provider --> Indexes : prepareComponents, componentResult
Indexes --> Model : readComponents, componentOf
Indexes --> Scan : componentSources filter one scan
Indexes --> Runtime : prepare per component
Runtime --> Progress : componentStorageKey
@enduml
