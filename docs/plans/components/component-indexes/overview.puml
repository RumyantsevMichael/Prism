@startuml
title component-indexes - slices
package "component-index-preparation" as Prep {
  interface "componentSources, prepareComponents" as Prepare
  interface "components, status, components_missing" as Result
  interface "storage per component" as Storage
}
package "component-search" as Search {
  interface "searchComponents" as Merge
}
package "component-reports" as Reports
package "component-baselines" as Baselines
package "component-index-views" as Views
Search ..> Prepare
Search ..> Result
Reports ..> Merge : plan candidates
Reports ..> Result
Baselines ..> Prepare
Baselines ..> Merge : snapshotId search
Views ..> Storage
Views ..> Prepare : refresh and rebuild
@enduml
