@startuml
title workspace-sync: units and dependencies
component "workspace-sync.mjs\nwatchWorkspace" as watch
component "review-app-server.mjs\nfetch settings, events stream" as app
component "review-server.mjs\nsync state, store-only actions" as review
component "record-store.mjs\nstore from a managed clone" as records
component "record-store-sync.mjs\nfetch, merge, push" as sync
component "review.js\nlast synced status" as page
app ..> watch
watch ..> sync
review ..> watch
review ..> records
records ..> sync
page ..> review
@enduml
