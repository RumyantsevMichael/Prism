@startuml
title kit-foundation
component "review.html" as html
component "kit/boot.js" as boot
component "kit/preferences.js" as prefs
component "kit/tokens.css" as tokens
component "kit/fonts" as fonts
component "kit/kit.css" as kitcss
component "kit/kit.js" as kitjs
component "review.css" as legacy
component "review-server.mjs\ncreateProjectReview" as server
component "review-preferences.mjs" as store
component "kit-guard.mjs" as guard
component "validate.yml" as ci
html --> boot
html --> tokens
html --> kitcss
html --> kitjs
tokens --> fonts
kitjs --> prefs
prefs --> server : GET/PUT /api/preferences
server --> store
legacy --> tokens
kitcss --> tokens
guard ..> tokens : exempt
ci ..> guard : npm test with a browser
@enduml
