@startuml
title kit-containers
component "kit/kit.js" as kit
component "prism-panel" as panel
component "prism-tree / item" as tree
component "prism-listbox / item" as listbox
component "prism-dialog" as dialog
component "prism-popover" as popover
component "prism-disclosure" as disclosure
component "prism-empty-state / banner / toast" as states
component "prism-stat / meter / spinner" as stats
component "prism-doc / prism-code" as content
component "prism-avatar" as avatar
component "prism-claim + claim-time.js" as claim
component "prism-stepper / step" as stepper
component "prism-breadcrumbs" as crumbs
component "catalog.js" as catalog
component "prism-button" as button
component "prism-field" as field
component "prism-tooltip" as tip
kit --> panel
kit --> tree
kit --> listbox
kit --> dialog
kit --> popover
kit --> disclosure
kit --> states
kit --> stats
kit --> content
kit --> avatar
kit --> claim
kit --> stepper
kit --> crumbs
panel --> button
dialog --> button
popover ..> button : for
states --> button
listbox ..> field : for
claim --> avatar
claim --> stats : lease meter
claim ..> tip
crumbs ..> tip
catalog --> kit
@enduml
