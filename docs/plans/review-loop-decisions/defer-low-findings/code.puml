@startuml
title Defer low findings - code
component "state.mjs\nresolve choice, closed gates" as State
component "review-ledger.mts\naccept_wave deferrals, DEFERRED, get_review deferred" as Ledger
component "initiative.mjs\nderived.deferredFindings" as Initiative
component "conservation-tools.mts\nreview tool descriptions" as Tools
