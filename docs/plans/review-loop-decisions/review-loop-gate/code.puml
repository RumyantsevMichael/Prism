@startuml
title Ask the review loop decision - code
component "review-ledger.mts\nassertReviewMayContinue, loop gate summary, return_to_design" as Ledger
component "state.mjs\nupdateCoordinationState ask" as State
component "verification.mjs\nreportContractDefects" as Verification
component "initiative.mjs\nreport_contract_defects" as Initiative
