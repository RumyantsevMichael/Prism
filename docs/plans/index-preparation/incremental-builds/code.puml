@startuml
title incremental-builds - units
package "repository-intelligence" {
  component "native-semantic-runtime.mts" as Runtime
  component "index-mirror.mts" as Mirror
}
package "native-runtime" {
  component "worker.mts" as Worker
  component "graph.mts" as Graph
  component "units.mts" as Units
  component "fragments.mts" as Fragments
}
Runtime --> Mirror : updateMirror, markIndexed
Runtime --> Worker : build with changedFiles, removedFiles
Worker --> Graph : sync named paths
Worker --> Units : derive changed files only
Worker --> Fragments : reuse unchanged fragments
@enduml
