@startuml
title Index preparation that finishes - slices
package "resumable-builds" as Resumable {
  interface "vectors in embedding progress" as Vectors
  interface "embeddings.bin store" as Store
  interface "stall watchdog and stop()" as Stall
}
package "structure-first" as Structure {
  interface "structure progress and stage pointers" as Stage
}
package "scoped-calls-ahead" as Ahead
package "incremental-builds" as Incremental {
  interface "mirror.json and change lists" as Mirror
}
package "sibling-reports" as Siblings
package "library-coverage" as Coverage
package "cross-index-ranking" as Ranking
Structure ..> Resumable : builds on the saved work
Ahead ..> Stall : pauses by stopping a build
Ahead ..> Store : resumes from saved embeddings
Ahead ..> Structure : after
Incremental ..> Stage : marks indexed when structure arrives
Incremental ..> Ahead : after
Siblings ..> Stage : structure-only preparation
Ranking ..> Stage : lexical-only answers carry no vector rank
@enduml
