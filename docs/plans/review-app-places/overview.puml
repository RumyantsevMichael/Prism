@startuml
title Navigate the review app by places - parts
package "places-compare" as Compare {
  interface "places-compare.mjs outline and report" as Outline
}
package "places-shell" as Shell {
  interface "rail, place head, choosePlace" as Rail
  interface "context place and trail crumb" as Place
}
package "work-place" as Work
package "attention-place" as Attention
package "history-roadmap-places" as HistoryRoadmap
package "knowledge-place" as Knowledge {
  interface "Knowledge sidebar and refs" as KnowledgeSidebar
}
package "knowledge-entry-points" as EntryPoints
Shell ..> Outline : frozen tests compare the scenes
Work ..> Rail : fills the Work sidebar
Attention ..> Rail : fills the Attention sidebar
HistoryRoadmap ..> Rail : fills History and Roadmap
Knowledge ..> Rail : fills the Knowledge sidebar
Knowledge ..> Place : Knowledge crumb
EntryPoints ..> KnowledgeSidebar : Touched and Changed pages and counts
@enduml
