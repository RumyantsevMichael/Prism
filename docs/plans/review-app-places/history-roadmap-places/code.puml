@startuml
title history-roadmap-places - units
component "workspace-model.mjs\ncomputeNavigation places.history" as Model
component "review.js\nrenderHistoryPlace, renderRoadmapPlace" as Sidebar
component "views/roadmap.js\nrenderRoadmap" as Page
component "roadmap.json decisions" as Roadmap
Model --> Roadmap : shipped and superseded, newest first
Sidebar --> Model : places.history
Sidebar --> Page : view choice and lane links
Page ..> Sidebar : announces its view
@enduml
