@startuml
title artifact-tools

component "workflow-config\nartifactKinds" as kinds
component "artifact-paths\nartifactAddress, malformedArtifactName,\nscopeFolder, artifactLocation" as paths
component "repository-names\ncheckRepositoryName" as names
component "record-store\nresolveArtifactFile, seenScopes" as store
