@startuml
title artifact-migration

component "record-store\nfirst access" as store
component "artifact-migration\nmigrateArtifacts, reference scan" as migration
component "artifact-paths" as paths
component "artifact-status\nrecorded status of moved files" as status
component "mcp\nmigration note" as mcp
component "roadmap\nview from the stored record" as roadmap
component "review-server\nawaitingMove and keptInCheckout notices" as review
component "record-store-sync\npull before the move" as sync
component "components\ndeclared component folders" as components

store --> migration
migration --> paths
migration --> status
migration --> roadmap
store --> sync
store --> components
mcp --> store
mcp --> migration
review --> paths
@enduml
