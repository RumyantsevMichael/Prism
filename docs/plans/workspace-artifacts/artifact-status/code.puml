@startuml
title artifact-status

component "artifact-status\nwrittenStatus, askApproval, answerApproval, accepted bytes" as status
component "store-artifacts\nstatus fields, ask_approval, accepted reads,\nidentity writes over stray entries" as tools
component "initiative\naccept_proposal accepted versions" as initiative
component "workspace-model\nAttention, recent changes, libraries" as model
component "actions\napproval target, gate.answer, ambiguous ids" as actions
component "review-server\nactions routes, 409 and 503 refusals, action events" as server
component "review page\nanswers through actions" as page
component "attention view\nwhole status, recent changes" as view
component "gate-wait and wait-for-gate-answers hook" as wait
component "mcp\nwait_for_user_gate artifact,\nsaved status records,\nundone removals and moves" as mcp
component "record-store-sync\nmerges bytes and status records\nby artifact identity, refuses or\nwithholds files above their bound,\nkeeps a removal unless the upstream\nedited the bytes, sends a contested\nmove back, records undone changes" as sync
component "artifact-paths\nidentity form, identities of a tree\nuntil none is shared" as paths
component "record-store\nshares identity files\nonly at artifact locations,\nbound of each store file kind" as layout
component "store-json\ndepth check in memory\nbounded by depth" as json
component "record readers\nstate, initiative, roadmap,\ndesign-view, verification,\nslice-design" as readers
component "artifact-migration\nledgers within 16 MiB,\nsplit when longer" as migration

tools --> status
initiative --> status
model --> status
server --> model
server --> actions
actions --> status
view --> page
page --> server
mcp --> wait
wait --> status
mcp --> sync
tools --> sync
tools --> paths
sync --> paths
sync --> layout
readers --> layout
readers --> json
migration --> json
migration --> layout
mcp --> migration
layout --> json
@enduml
