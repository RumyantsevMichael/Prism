@startuml
title artifact-review

component "artifact-comments\naddComment, listComments pages,\nform check, move, removal,\n1000 entries per folder,\nfolders of seen artifacts only" as comments
component "review-server\n/api/artifact comment pages,\nactions routes, 503 refusals" as server
component "actions\nartifact target, artifact.comment" as actions
component "artifact-review view\nscope, diff, numbered lines,\ncomments, More comments" as view
component "line-diff\ndiffHtml" as diff
component "preview view" as preview
component "store-artifacts\nget_artifact comment pages,\nmove_scope and remove carry comments" as tools
component "artifact-status\naccepted bytes" as status
component "workspace-model\nrecent changes" as model
component "record-store-sync\nmerge places synced comments\nby artifact identity,\nrewrites only comments of the form,\nsaves the rest aside,\nkeeps folders within 1000" as sync
component "mcp\nreports saved comments,\nquotes only the comment form,\nnotes within 32 KiB" as mcp

server --> actions
actions --> comments
server --> status
tools --> comments
model --> comments
model --> tools
sync --> comments
mcp --> sync
preview --> view
view --> diff
view --> server
@enduml
