      "contractDefects": [
        {
          "clause": "4",
          "reason": "Main removed the agentFlow setting in #125 (4729690): update_coordination_state refuses settings.agentFlow and a stored value is dropped on read, so the contract lists a setting action for a setting that no longer exists. Clauses 4, 6, 8 (and the initiative-settings requirements 1 and 2) must drop agentFlow.",
          "reportedAt": "2026-11-06T00:21:00.259Z"
        },
        {
          "clause": "32",
          "reason": "Main now prepares one native index per component (#131, 8637963), so the assumption that every index target of a checkout shares one index and rebuilding any rebuilds all is stale; index.rebuild must start the rebuild of the named component index through the per-component indexer.",
          "reportedAt": "2026-11-06T00:21:00.259Z"
        },
        {
          "clause": "22",
          "reason": "Main changed user gate records in #127 (1d79c84): gates now carry context, options with consequences, and a recommendation; gate.answer fields and the merge of pending gates must account for the new gate keys.",
          "reportedAt": "2026-11-06T00:21:00.259Z"
        }
      ]
    },
